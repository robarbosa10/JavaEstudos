package exerciciosEnum004;

public enum PilotosF1 {
	HAMILTON("Lewis Hamilton", "Inglaterra"),
	LECLERC("Charles Leclerc", "Monaco"),
	RUSSEL("Russel", "Inglaterra"),
	KIMI("Kimi Antonelli", "Italia"),
	MAX("Max Verstappen", "Holanda"),
	TSUNODA("Yuki Tsunoda", "Japao");
	
	private final String nome;
	private final String pais;
	private EquipeF1 equipe;
	
	PilotosF1(String nome, String pais) {
		this.nome = nome;
		this.pais = pais;
		this.equipe = null;
	}

	public final String getNome() {
		return nome;
	}

	public final String getPais() {
		return pais;
	}

	public final EquipeF1 getEquipe() {
		return equipe;
	}
	
	public void AddEquipe(EquipeF1 e1) {
		this.equipe = e1;
	}
}
